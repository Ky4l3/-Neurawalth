default_platform(:ios)

platform :ios do
  desc "CI lane: analyze, test, and build unsigned iOS IPA"
  lane :ci do
    sh("flutter --version")
    sh("flutter pub get")
    sh("flutter analyze")
    sh("flutter test --coverage || true")
    sh("flutter build ios --release --no-codesign")
  end

  desc "Build and upload to TestFlight using App Store Connect API key (env vars)"
  lane :beta do
    # Requires env vars: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 of .p8)
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      in_house: false
    )

    sh("flutter pub get")
    sh("flutter build ipa --release")

    ipa_path = "build/ios/ipa/Runner.ipa"
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    pilot(api_key: api_key, ipa: ipa_path, skip_waiting_for_build_processing: true)
  end

  desc "Prepare App Store submission (build only; upload handled via beta)"
  lane :release do
    sh("flutter pub get")
    sh("flutter build ipa --release")
  end
end



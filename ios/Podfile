platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

install! 'cocoapods', :disable_input_output_paths => true

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run 'flutter pub get' to generate it."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Ensure Flutter is configured.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

use_frameworks! :linkage => :static

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  flutter_additional_ios_build_settings(installer)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      keys = ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'GCC_PREPROCESSOR_DEFINITIONS']
      keys.each do |key|
        next unless config.build_settings[key]
        value = config.build_settings[key]
        if value.is_a?(Array)
          config.build_settings[key] = value.reject { |tok| tok.to_s.start_with?('-G') }
        else
          updated = value.to_s.split(/\s+/).reject { |tok| tok.start_with?('-G') }.join(' ')
          config.build_settings[key] = updated
        end
      end

      # Clean any settings that accidentally include -G tokens
      config.build_settings.keys.each do |k|
        v = config.build_settings[k]
        if v.is_a?(String) && v.include?('-G')
          config.build_settings[k] = v.split(/\s+/).reject { |tok| tok.start_with?('-G') }.join(' ')
        elsif v.is_a?(Array)
          config.build_settings[k] = v.reject { |tok| tok.to_s.start_with?('-G') }
        end
      end

      # Ensure Swift version
      config.build_settings['SWIFT_VERSION'] ||= '5.0'
    end
  end
end



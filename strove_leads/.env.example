# Strove Leads — Environment Variables
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=false
PORT=5000

# Database path (use absolute path in production)
DB_PATH=strove_leads.db

# API Keys (optional — app works without them but with reduced coverage)
SERP_API_KEY=       # https://serpapi.com — for reliable Google scraping (~$50/mo)
HUNTER_API_KEY=     # https://hunter.io — for finding emails from domains
SNOV_API_KEY=       # https://snov.io — alternative email finder

# Proxy (optional — for avoiding rate limits)
# Format: http://user:pass@host:port,http://user2:pass2@host2:port2
PROXY_LIST=
